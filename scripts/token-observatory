#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$root/backend/launcher.py" ]; then
  app="$root"
else
  app="${XDG_DATA_HOME:-$HOME/.local/share}/token-observatory/app"
fi
python="$app/.venv/bin/python"
if [ ! -x "$python" ]; then
  echo 'token-observatory: private Python runtime missing; run install.sh.' >&2
  exit 1
fi
exec "$python" "$app/launcher.py" "$@"
